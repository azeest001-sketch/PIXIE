# Copy this file to .env and fill in your keys.
# Never commit a real .env file.

# --- RapidAPI (price collector) ---
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com
AMAZON_RAPIDAPI_HOST=real-time-amazon-data.p.rapidapi.com
FLIPKART_RAPIDAPI_HOST=flipkart-product-data-api.p.rapidapi.com

# --- Email alerts (smtplib / Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_gmail_address_here
SMTP_PASSWORD=your_gmail_app_password_here
ALERT_FROM_EMAIL=your_gmail_address_here
ALERT_TO_EMAIL=teammate@example.com

# --- Scheduler (clock times, 24h) ---
# Two checks a day stays inside a small RapidAPI plan. Add a third time only if the plan allows it.
CHECK_TIMES=10:15,22:15
SCHEDULER_TIMEZONE=Asia/Kolkata
# true runs one price check as soon as the scheduler starts.
RUN_ON_START=false
POLL_INTERVAL_SECONDS=3600

# --- Storage ---
DATABASE_PATH=backend/data/pixie.db

# --- Frontend ---
VITE_API_URL=http://127.0.0.1:8001
